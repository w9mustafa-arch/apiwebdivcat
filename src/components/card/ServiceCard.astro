---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

const { data, id } = Astro.props;

const whatsappNumber = "212XXXXXXXXX";
const whatsappMessage = "Bonjour, je souhaite commander une livraison.";
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`;
---

<article class="">
  <a href={`/service/${id}`}>
    <Image
      src={data.thumbnail}
      alt={data.title}
      width="400"
      height="200"
      format="avif"
      quality={60}
      class="w-full h-auto aspect-2/1 rounded-xl object-cover mb-4"
    />

    <h3 class="font-semibold text-xl sm:text-2xl my-4">{data.title}</h3>

    <p class="mb-4 mt-4 text-sm sm:text-base">{data.description}</p>
  </a>

  <a
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="btn btn-outline hover:bg-main hover:text-white hover:border-main rounded-lg inline-flex"
  >
    Commander maintenant
    <Icon name="lucide:arrow-up-right" size={16} />
  </a>
</article>
