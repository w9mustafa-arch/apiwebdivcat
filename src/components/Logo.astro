---
import Image from "astro/components/Image.astro";
const { mode = "light" } = Astro.props;
---

<a href="/" class="logo">
  <Image
    src={mode == "light" ? `/img/Myy.svg` : `/img/Myy.svg`}
    alt="logo"
    width="140"
    height="60"
    fetchpriority="high"
    loading="eager"
    class="w-auto h-auto dark:hidden"
  />
  <Image
    src="/img/Myy.svg"
    alt="logo"
    width="140"
    height="60"
    loading="eager"
    class="hidden dark:block"
  />
</a>
