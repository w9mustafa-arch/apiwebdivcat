---
import { Icon } from "astro-icon/components";
import Swiper from "../Swiper.astro";
---

<section class="section section-reviews">
  <div class="container">

    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-10">
      <h2>Ce que nos clients disent</h2>

      <p class="mt-3 text-gray-600">
        Découvrez les avis de nos clients sur leur expérience avec
        <strong>Kech Delivery</strong>.
      </p>
    </div>

    <!-- Google style rating -->
    <div
      class="max-w-xl mx-auto mb-10 bg-white rounded-2xl border border-gray-200 p-6 sm:p-8 shadow-sm"
    >
      <div class="flex flex-col sm:flex-row items-center justify-center gap-5">

        <!-- Rating -->
        <div class="text-center">
          <div class="text-5xl font-bold leading-none text-dark">
            4.9
          </div>

          <div class="flex justify-center gap-0.5 mt-3 text-yellow-400">
            {
              Array.from({ length: 5 }).map(() => (
                <Icon name="heroicons:star-solid" size={22} />
              ))
            }
          </div>

          <p class="text-sm text-gray-500 mt-2">
            Basé sur 120 avis
          </p>
        </div>

        <!-- Divider -->
        <div class="hidden sm:block w-px h-20 bg-gray-200"></div>

        <!-- Google -->
        <div class="text-center sm:text-left">
          <div class="flex items-center justify-center sm:justify-start gap-2">
            <span class="text-2xl font-bold">
              Google
            </span>
          </div>

          <p class="text-sm text-gray-500 mt-1">
            Avis de nos clients
          </p>
        </div>

      </div>
    </div>

    <!-- Reviews -->
    <Swiper
      pagination={false}
      navigation={true}
      id="reviewsSwiper"
      prev="reviews-prev"
      next="reviews-next"
    >

      <!-- Review 1 -->
      <div class="swiper-slide">
        <article
          class="relative bg-white rounded-2xl border border-gray-200 p-6 sm:p-8 shadow-sm h-full"
        >

          <!-- Quote -->
          <div
            class="absolute top-5 right-6 text-5xl font-bold text-main/10 leading-none"
          >
            “
          </div>

          <!-- User -->
          <div class="flex items-center gap-4">

            <div
              class="w-12 h-12 rounded-full bg-main text-white flex items-center justify-center font-bold text-lg"
            >
              M
            </div>

            <div>
              <p class="font-semibold text-dark">
                Marie
              </p>

              <p class="text-sm text-gray-500">
                Cliente vérifiée
              </p>
            </div>

          </div>

          <!-- Stars -->
          <div class="flex gap-0.5 text-yellow-400 mt-5">
            {
              Array.from({ length: 5 }).map(() => (
                <Icon name="heroicons:star-solid" size={19} />
              ))
            }
          </div>

          <!-- Review -->
          <p class="text-gray-600 leading-7 mt-4">
            Excellent service ! La livraison était rapide et le livreur
            était très professionnel. Je recommande Kech Delivery.
          </p>

        </article>
      </div>


      <!-- Review 2 -->
      <div class="swiper-slide">
        <article
          class="relative bg-white rounded-2xl border border-gray-200 p-6 sm:p-8 shadow-sm h-full"
        >

          <div
            class="absolute top-5 right-6 text-5xl font-bold text-main/10 leading-none"
          >
            “
          </div>

          <div class="flex items-center gap-4">

            <div
              class="w-12 h-12 rounded-full bg-dark text-white flex items-center justify-center font-bold text-lg"
            >
              A
            </div>

            <div>
              <p class="font-semibold text-dark">
                Ahmed
              </p>

              <p class="text-sm text-gray-500">
                Client vérifié
              </p>
            </div>

          </div>

          <div class="flex gap-0.5 text-yellow-400 mt-5">
            {
              Array.from({ length: 5 }).map(() => (
                <Icon name="heroicons:star-solid" size={19} />
              ))
            }
          </div>

          <p class="text-gray-600 leading-7 mt-4">
            Très pratique pour commander depuis un restaurant.
            La commande est arrivée rapidement et sans problème.
          </p>

        </article>
      </div>


      <!-- Review 3 -->
      <div class="swiper-slide">
        <article
          class="relative bg-white rounded-2xl border border-gray-200 p-6 sm:p-8 shadow-sm h-full"
        >

          <div
            class="absolute top-5 right-6 text-5xl font-bold text-main/10 leading-none"
          >
            “
          </div>

          <div class="flex items-center gap-4">

            <div
              class="w-12 h-12 rounded-full bg-main text-white flex items-center justify-center font-bold text-lg"
            >
              S
            </div>

            <div>
              <p class="font-semibold text-dark">
                Sophie
              </p>

              <p class="text-sm text-gray-500">
                Cliente vérifiée
              </p>
            </div>

          </div>

          <div class="flex gap-0.5 text-yellow-400 mt-5">
            {
              Array.from({ length: 5 }).map(() => (
                <Icon name="heroicons:star-solid" size={19} />
              ))
            }
          </div>

          <p class="text-gray-600 leading-7 mt-4">
            Service très pratique et rapide à Marrakech. J'ai pu recevoir
            ma commande directement à mon hôtel. Merci !
          </p>

        </article>
      </div>

    </Swiper>

  </div>
</section>

<script>
  import Swiper from "swiper";
  import { Navigation } from "swiper/modules";

  new Swiper("#reviewsSwiper", {
    modules: [Navigation],

    loop: true,

    spaceBetween: 20,

    slidesPerView: 1,

    breakpoints: {
      768: {
        slidesPerView: 2,
      },

      1024: {
        slidesPerView: 3,
      },
    },

    navigation: {
      nextEl: ".reviews-next",
      prevEl: ".reviews-prev",
    },
  });
</script>
