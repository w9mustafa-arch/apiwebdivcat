---
import { Icon } from "astro-icon/components";
import Swiper from "../Swiper.astro";
---

<section class="section section-reviews">
  <div class="container">

    <!-- Section Header -->
    <div class="mb-8">
      <h2>Avis de nos clients</h2>

      <p class="mt-4 max-w-2xl text-gray-600 dark:text-gray-300">
        Découvrez les avis laissés par nos clients après leur expérience
        avec Kech Delivery à Marrakech.
      </p>
    </div>

    <!-- Reviews Slider -->
    <div class="reviews-slider">

      <Swiper
        pagination={false}
        navigation={true}
        id="mySwiper"
        prev="swiper-prev"
        next="swiper-next"
      >

        <!-- Review 1 -->
        <div class="swiper-slide">
          <article
            class="bg-gray-50 dark:bg-dark border border-gray-200 dark:border-dark rounded-xl p-6 sm:p-7 h-full"
          >

            <!-- Customer -->
            <div class="flex items-start justify-between gap-4">

              <div class="flex items-center gap-3">

                <!-- Avatar -->
                <div
                  class="w-12 h-12 rounded-full bg-gray-200 dark:bg-gray-700 flex items-center justify-center shrink-0"
                >
                  <span class="font-semibold text-gray-600 dark:text-gray-200 text-lg">
                    M
                  </span>
                </div>

                <!-- Name -->
                <div>
                  <p class="font-semibold">
                    Mohamed A.
                  </p>

                  <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">
                    Local Guide
                  </p>
                </div>

              </div>

              <!-- Google Icon -->
              <div class="shrink-0">

                <svg
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  aria-label="Google"
                >
                  <path
                    d="M21.35 12.27c0-.79-.07-1.55-.2-2.27H12v4.3h5.24a4.48 4.48 0 0 1-1.94 2.94v2.45h3.14c1.84-1.69 2.91-4.18 2.91-7.42Z"
                    fill="#4285F4"
                  />
                  <path
                    d="M12 21.5c2.63 0 4.84-.87 6.45-2.36l-3.14-2.45c-.87.58-1.98.92-3.31.92-2.54 0-4.69-1.72-5.46-4.03H3.29v2.53A9.74 9.74 0 0 0 12 21.5Z"
                    fill="#34A853"
                  />
                  <path
                    d="M6.54 13.58a5.86 5.86 0 0 1 0-3.76V7.29H3.29a9.5 9.5 0 0 0 0 8.82l3.25-2.53Z"
                    fill="#FBBC05"
                  />
                  <path
                    d="M12 5.79c1.43 0 2.71.49 3.72 1.46l2.79-2.79C16.84 2.87 14.63 2 12 2a9.74 9.74 0 0 0-8.71 5.29l3.25 2.53C7.31 7.51 9.46 5.79 12 5.79Z"
                    fill="#EA4335"
                  />
                </svg>

              </div>

            </div>

            <!-- Rating -->
            <div class="flex items-center gap-2 mt-5">

              <div class="flex gap-0.5 text-yellow-500">
                {
                  Array.from({ length: 5 }).map(() => (
                    <Icon name="heroicons:star-solid" size={18} />
                  ))
                }
              </div>

              <span class="text-sm text-gray-500 dark:text-gray-400">
                Il y a 2 semaines
              </span>

            </div>

            <!-- Review -->
            <p class="text-sm leading-6 mt-4">
              Excellent service ! Livraison rapide et livreur très
              professionnel. Ma commande est arrivée à temps et tout
              s'est très bien passé.
            </p>

          </article>
        </div>


        <!-- Review 2 -->
        <div class="swiper-slide">
          <article
            class="bg-gray-50 dark:bg-dark border border-gray-200 dark:border-dark rounded-xl p-6 sm:p-7 h-full"
          >

            <div class="flex items-start justify-between gap-4">

              <div class="flex items-center gap-3">

                <!-- Avatar -->
                <div
                  class="w-12 h-12 rounded-full bg-gray-200 dark:bg-gray-700 flex items-center justify-center shrink-0"
                >
                  <span class="font-semibold text-gray-600 dark:text-gray-200 text-lg">
                    S
                  </span>
                </div>

                <!-- Name -->
                <div>
                  <p class="font-semibold">
                    Sarah M.
                  </p>

                  <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">
                    Local Guide
                  </p>
                </div>

              </div>

              <!-- Google Icon -->
              <div class="shrink-0">

                <svg
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  aria-label="Google"
                >
                  <path
                    d="M21.35 12.27c0-.79-.07-1.55-.2-2.27H12v4.3h5.24a4.48 4.48 0 0 1-1.94 2.94v2.45h3.14c1.84-1.69 2.91-4.18 2.91-7.42Z"
                    fill="#4285F4"
                  />
                  <path
                    d="M12 21.5c2.63 0 4.84-.87 6.45-2.36l-3.14-2.45c-.87.58-1.98.92-3.31.92-2.54 0-4.69-1.72-5.46-4.03H3.29v2.53A9.74 9.74 0 0 0 12 21.5Z"
                    fill="#34A853"
                  />
                  <path
                    d="M6.54 13.58a5.86 5.86 0 0 1 0-3.76V7.29H3.29a9.5 9.5 0 0 0 0 8.82l3.25-2.53Z"
                    fill="#FBBC05"
                  />
                  <path
                    d="M12 5.79c1.43 0 2.71.49 3.72 1.46l2.79-2.79C16.84 2.87 14.63 2 12 2a9.74 9.74 0 0 0-8.71 5.29l3.25 2.53C7.31 7.51 9.46 5.79 12 5.79Z"
                    fill="#EA4335"
                  />
                </svg>

              </div>

            </div>

            <!-- Rating -->
            <div class="flex items-center gap-2 mt-5">

              <div class="flex gap-0.5 text-yellow-500">
                {
                  Array.from({ length: 5 }).map(() => (
                    <Icon name="heroicons:star-solid" size={18} />
                  ))
                }
              </div>

              <span class="text-sm text-gray-500 dark:text-gray-400">
                Il y a 1 mois
              </span>

            </div>

            <!-- Review -->
            <p class="text-sm leading-6 mt-4">
              Très bon service de livraison à Marrakech. La commande a été
              récupérée rapidement et livrée directement à mon hôtel.
              Très pratique et efficace !
            </p>

          </article>
        </div>


        <!-- Review 3 -->
        <div class="swiper-slide">
          <article
            class="bg-gray-50 dark:bg-dark border border-gray-200 dark:border-dark rounded-xl p-6 sm:p-7 h-full"
          >

            <div class="flex items-start justify-between gap-4">

              <div class="flex items-center gap-3">

                <!-- Avatar -->
                <div
                  class="w-12 h-12 rounded-full bg-gray-200 dark:bg-gray-700 flex items-center justify-center shrink-0"
                >
                  <span class="font-semibold text-gray-600 dark:text-gray-200 text-lg">
                    T
                  </span>
                </div>

                <!-- Name -->
                <div>
                  <p class="font-semibold">
                    Thomas R.
                  </p>

                  <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">
                    Local Guide
                  </p>
                </div>

              </div>

              <!-- Google Icon -->
              <div class="shrink-0">

                <svg
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  aria-label="Google"
                >
                  <path
                    d="M21.35 12.27c0-.79-.07-1.55-.2-2.27H12v4.3h5.24a4.48 4.48 0 0 1-1.94 2.94v2.45h3.14c1.84-1.69 2.91-4.18 2.91-7.42Z"
                    fill="#4285F4"
                  />
                  <path
                    d="M12 21.5c2.63 0 4.84-.87 6.45-2.36l-3.14-2.45c-.87.58-1.98.92-3.31.92-2.54 0-4.69-1.72-5.46-4.03H3.29v2.53A9.74 9.74 0 0 0 12 21.5Z"
                    fill="#34A853"
                  />
                  <path
                    d="M6.54 13.58a5.86 5.86 0 0 1 0-3.76V7.29H3.29a9.5 9.5 0 0 0 0 8.82l3.25-2.53Z"
                    fill="#FBBC05"
                  />
                  <path
                    d="M12 5.79c1.43 0 2.71.49 3.72 1.46l2.79-2.79C16.84 2.87 14.63 2 12 2a9.74 9.74 0 0 0-8.71 5.29l3.25 2.53C7.31 7.51 9.46 5.79 12 5.79Z"
                    fill="#EA4335"
                  />
                </svg>

              </div>

            </div>

            <!-- Rating -->
            <div class="flex items-center gap-2 mt-5">

              <div class="flex gap-0.5 text-yellow-500">
                {
                  Array.from({ length: 5 }).map(() => (
                    <Icon name="heroicons:star-solid" size={18} />
                  ))
                }
              </div>

              <span class="text-sm text-gray-500 dark:text-gray-400">
                Il y a 2 mois
              </span>

            </div>

            <!-- Review -->
            <p class="text-sm leading-6 mt-4">
              Service rapide et sérieux. Le livreur était ponctuel,
              sympathique et professionnel. Je recommande Kech Delivery
              sans hésitation.
            </p>

          </article>
        </div>

      </Swiper>

      <!-- Navigation Dots -->
      <div class="reviews-navigation">
        <button
          type="button"
          class="swiper-prev"
          aria-label="Avis précédent"
        ></button>

        <button
          type="button"
          class="swiper-next"
          aria-label="Avis suivant"
        ></button>
      </div>

    </div>
  </div>
</section>


<script>
  import Swiper from "swiper";
  import { Navigation } from "swiper/modules";

  new Swiper("#mySwiper", {
    modules: [Navigation],

    loop: true,

    spaceBetween: 20,

    slidesPerView: 1,

    breakpoints: {
      768: {
        slidesPerView: 2,
      },

      1024: {
        slidesPerView: 3,
      },
    },

    navigation: {
      nextEl: ".swiper-next",
      prevEl: ".swiper-prev",
    },
  });
</script>


<style>
  /* Navigation */
  .reviews-navigation {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;

    margin-top: 28px;
  }

  /* Dots */
  .reviews-navigation .swiper-prev,
  .reviews-navigation .swiper-next {
    width: 8px;
    height: 8px;

    min-width: 8px;
    min-height: 8px;

    padding: 0;
    margin: 0;

    border: 0;
    border-radius: 9999px;

    background: #d1d5db;

    cursor: pointer;

    transition:
      width 0.25s ease,
      background-color 0.25s ease,
      transform 0.25s ease;
  }

  /* Hover */
  .reviews-navigation .swiper-prev:hover,
  .reviews-navigation .swiper-next:hover {
    background: #f44e1e;
    transform: scale(1.25);
  }

  /* Hide default Swiper arrows */
  .reviews-navigation .swiper-prev::after,
  .reviews-navigation .swiper-next::after {
    display: none;
    content: none;
  }

  /* Dark mode */
  :global(.dark) .reviews-navigation .swiper-prev,
  :global(.dark) .reviews-navigation .swiper-next {
    background: #4b5563;
  }

  :global(.dark) .reviews-navigation .swiper-prev:hover,
  :global(.dark) .reviews-navigation .swiper-next:hover {
    background: #f44e1e;
  }

  /* Mobile */
  @media (max-width: 767px) {
    .reviews-navigation {
      margin-top: 24px;
      gap: 7px;
    }

    .reviews-navigation .swiper-prev,
    .reviews-navigation .swiper-next {
      width: 7px;
      height: 7px;

      min-width: 7px;
      min-height: 7px;
    }
  }
</style>
