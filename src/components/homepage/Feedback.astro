---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import Swiper from "../Swiper.astro";
---

<section class="section section-reviews">
  <div class="container">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-center">

      <div>
        <h2>Avis de nos clients</h2>

        <p class="mt-4">
          Découvrez les expériences de nos clients avec Kech Delivery.
          Un service de livraison rapide, fiable et disponible à Marrakech.
        </p>
      </div>

      <div>
        <Swiper
          pagination={false}
          navigation={true}
          id="mySwiper"
          prev="swiper-prev"
          next="swiper-next"
        >

          <!-- Avis 1 -->
          <div class="swiper-slide">
            <article
              class="rounded-xl p-10 grid grid-cols-1 sm:grid-cols-[100px_1fr] gap-4 items-center border border-gray-200 border-t-4 border-t-main border-r-4 border-r-main relative"
            >
              <Image
                src="/img/comments/cmnt1.webp"
                alt="Avis client"
                format="webp"
                quality={45}
                width="100"
                height="100"
                class="w-full h-auto max-w-25 rounded-full"
              />

              <div class="grid gap-0">

                <div class="flex flex-wrap justify-between items-center gap-4">
                  <div>
                    <p class="text-lg font-semibold">
                      Mohamed A.
                    </p>

                    <p class="text-sm text-gray-500">
                      Client vérifié · Google
                    </p>
                  </div>

                  <Image
                    src="/img/icons/quote.svg"
                    width="50"
                    height="50"
                    alt="quote"
                    class="w-auto h-auto max-w-18.75 absolute top-2 right-2"
                  />
                </div>

                <div class="flex gap-1 items-center text-yellow-500 mt-2 mb-4">
                  {
                    Array.from({ length: 5 }).map(() => (
                      <Icon name="heroicons:star-solid" size={24} />
                    ))
                  }
                </div>

                <p class="text-sm">
                  Excellent service ! Livraison rapide et livreur très
                  professionnel. Ma commande est arrivée à temps et tout
                  s'est très bien passé. Je recommande vivement Kech Delivery.
                </p>

              </div>
            </article>
          </div>


          <!-- Avis 2 -->
          <div class="swiper-slide">
            <article
              class="rounded-xl p-10 grid grid-cols-1 sm:grid-cols-[100px_1fr] gap-4 items-center border border-gray-200 border-t-4 border-t-main border-r-4 border-r-main relative"
            >
              <Image
                src="/img/comments/cmnt1.webp"
                alt="Avis client"
                format="webp"
                quality={45}
                width="100"
                height="100"
                class="w-full h-auto max-w-25 rounded-full"
              />

              <div class="grid gap-0">

                <div class="flex flex-wrap justify-between items-center gap-4">
                  <div>
                    <p class="text-lg font-semibold">
                      Sarah M.
                    </p>

                    <p class="text-sm text-gray-500">
                      Cliente vérifiée · Google
                    </p>
                  </div>

                  <Image
                    src="/img/icons/quote.svg"
                    width="50"
                    height="50"
                    alt="quote"
                    class="w-auto h-auto max-w-18.75 absolute top-2 right-2"
                  />
                </div>

                <div class="flex gap-1 items-center text-yellow-500 mt-2 mb-4">
                  {
                    Array.from({ length: 5 }).map(() => (
                      <Icon name="heroicons:star-solid" size={24} />
                    ))
                  }
                </div>

                <p class="text-sm">
                  Très bon service de livraison à Marrakech. La commande a
                  été récupérée rapidement et livrée directement à mon hôtel.
                  Très pratique et efficace !
                </p>

              </div>
            </article>
          </div>


          <!-- Avis 3 -->
          <div class="swiper-slide">
            <article
              class="rounded-xl p-10 grid grid-cols-1 sm:grid-cols-[100px_1fr] gap-4 items-center border border-gray-200 border-t-4 border-t-main border-r-4 border-r-main relative"
            >
              <Image
                src="/img/comments/cmnt1.webp"
                alt="Avis client"
                format="webp"
                quality={45}
                width="100"
                height="100"
                class="w-full h-auto max-w-25 rounded-full"
              />

              <div class="grid gap-0">

                <div class="flex flex-wrap justify-between items-center gap-4">
                  <div>
                    <p class="text-lg font-semibold">
                      Thomas R.
                    </p>

                    <p class="text-sm text-gray-500">
                      Client vérifié · Google
                    </p>
                  </div>

                  <Image
                    src="/img/icons/quote.svg"
                    width="50"
                    height="50"
                    alt="quote"
                    class="w-auto h-auto max-w-18.75 absolute top-2 right-2"
                  />
                </div>

                <div class="flex gap-1 items-center text-yellow-500 mt-2 mb-4">
                  {
                    Array.from({ length: 5 }).map(() => (
                      <Icon name="heroicons:star-solid" size={24} />
                    ))
                  }
                </div>

                <p class="text-sm">
                  Service rapide et sérieux. Le livreur était ponctuel,
                  sympathique et professionnel. Je n'hésiterai pas à utiliser
                  Kech Delivery à nouveau.
                </p>

              </div>
            </article>
          </div>

        </Swiper>
      </div>
    </div>
  </div>
</section>

<script>
  import Swiper from "swiper";
  import { Navigation } from "swiper/modules";

  new Swiper("#mySwiper", {
    modules: [Navigation],

    loop: true,

    navigation: {
      nextEl: ".swiper-next",
      prevEl: ".swiper-prev",
    },
  });
</script>
