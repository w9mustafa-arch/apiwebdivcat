---
import { Icon } from "astro-icon/components";
---

<section class="section section-services">
  <div class="container">

    <!-- Header -->
    <div class="border-b border-b-main pb-10">
      <div>
        <div class="flex flex-wrap justify-between items-center gap-3">

          <p class="font-semibold mb-3 text-xl">
            Nos zones de livraison
          </p>

          <p>
            <a
              href="/contact"
              class="text-main underline hover:no-underline"
            >
              Vérifier ma zone
            </a>
          </p>

        </div>

        <p class="mb-3">
          Nous assurons nos livraisons dans les principaux quartiers
          de Marrakech, rapidement et en toute simplicité.
        </p>
      </div>
    </div>


    <!-- Search + Zones -->
    <div class="mt-10">

      <!-- Search -->
      <div class="max-w-xl mx-auto mb-6">

        <div
          class="flex items-center
          dark:bg-dark dark:border-dark
          bg-gray-50 border border-gray-200
          rounded-lg
          transition-all
          focus-within:border-main"
        >

          <div
            class="flex items-center justify-center
            text-main pl-4 shrink-0"
          >
            <Icon
              name="lucide:search"
              size={21}
            />
          </div>

          <input
            id="zone-search"
            type="search"
            placeholder="Rechercher votre quartier..."
            class="w-full px-3 py-3.5
            bg-transparent
            border-0 outline-none
            text-sm sm:text-base
            text-black dark:text-white
            placeholder:text-gray-400
            dark:placeholder:text-gray-500"
          />

        </div>

      </div>


      <!-- Zones -->
      <div
        id="delivery-zones"
        class="grid grid-cols-2
        sm:grid-cols-3
        lg:grid-cols-4
        gap-3 sm:gap-4"
      >

        <!-- Guéliz -->
        <div
          class="zone-item group
          flex items-center gap-3
          dark:bg-dark dark:border-dark
          bg-gray-50 border border-gray-200
          rounded-lg p-4
          transition-all duration-300
          hover:border-main
          hover:bg-main/5"
          data-zone="Guéliz"
        >
          <div
            class="flex items-center justify-center
            shrink-0
            bg-main text-white
            rounded-full
            w-10 h-10"
          >
            <Icon name="lucide:map-pin" size={20} />
          </div>

          <span class="font-medium text-sm sm:text-base">
            Guéliz
          </span>
        </div>


        <!-- Hivernage -->
        <div
          class="zone-item group
          flex items-center gap-3
          dark:bg-dark dark:border-dark
          bg-gray-50 border border-gray-200
          rounded-lg p-4
          transition-all duration-300
          hover:border-main
          hover:bg-main/5"
          data-zone="Hivernage"
        >
          <div
            class="flex items-center justify-center
            shrink-0
            bg-main text-white
            rounded-full
            w-10 h-10"
          >
            <Icon name="lucide:map-pin" size={20} />
          </div>

          <span class="font-medium text-sm sm:text-base">
            Hivernage
          </span>
        </div>


        <!-- Agdal -->
        <div
          class="zone-item group
          flex items-center gap-3
          dark:bg-dark dark:border-dark
          bg-gray-50 border border-gray-200
          rounded-lg p-4
          transition-all duration-300
          hover:border-main
          hover:bg-main/5"
          data-zone="Agdal"
        >
          <div
            class="flex items-center justify-center
            shrink-0
            bg-main text-white
            rounded-full
            w-10 h-10"
          >
            <Icon name="lucide:map-pin" size={20} />
          </div>

          <span class="font-medium text-sm sm:text-base">
            Agdal
          </span>
        </div>


        <!-- M'Hamid -->
        <div
          class="zone-item group
          flex items-center gap-3
          dark:bg-dark dark:border-dark
          bg-gray-50 border border-gray-200
          rounded-lg p-4
          transition-all duration-300
          hover:border-main
          hover:bg-main/5"
          data-zone="M'Hamid"
        >
          <div
            class="flex items-center justify-center
            shrink-0
            bg-main text-white
            rounded-full
            w-10 h-10"
          >
            <Icon name="lucide:map-pin" size={20} />
          </div>

          <span class="font-medium text-sm sm:text-base">
            M'Hamid
          </span>
        </div>


        <!-- Massira -->
        <div
          class="zone-item group
          flex items-center gap-3
          dark:bg-dark dark:border-dark
          bg-gray-50 border border-gray-200
          rounded-lg p-4
          transition-all duration-300
          hover:border-main
          hover:bg-main/5"
          data-zone="Massira"
        >
          <div
            class="flex items-center justify-center
            shrink-0
            bg-main text-white
            rounded-full
            w-10 h-10"
          >
            <Icon name="lucide:map-pin" size={20} />
          </div>

          <span class="font-medium text-sm sm:text-base">
            Massira
          </span>
        </div>


        <!-- Palmeraie -->
        <div
          class="zone-item group
          flex items-center gap-3
          dark:bg-dark dark:border-dark
          bg-gray-50 border border-gray-200
          rounded-lg p-4
          transition-all duration-300
          hover:border-main
          hover:bg-main/5"
          data-zone="Palmeraie"
        >
          <div
            class="flex items-center justify-center
            shrink-0
            bg-main text-white
            rounded-full
            w-10 h-10"
          >
            <Icon name="lucide:map-pin" size={20} />
          </div>

          <span class="font-medium text-sm sm:text-base">
            Palmeraie
          </span>
        </div>


        <!-- Route de l'Ourika -->
        <div
          class="zone-item group
          flex items-center gap-3
          dark:bg-dark dark:border-dark
          bg-gray-50 border border-gray-200
          rounded-lg p-4
          transition-all duration-300
          hover:border-main
          hover:bg-main/5"
          data-zone="Route de l'Ourika"
        >
          <div
            class="flex items-center justify-center
            shrink-0
            bg-main text-white
            rounded-full
            w-10 h-10"
          >
            <Icon name="lucide:map-pin" size={20} />
          </div>

          <span class="font-medium text-sm sm:text-base">
            Route de l'Ourika
          </span>
        </div>


        <!-- Centre Ville -->
        <div
          class="zone-item group
          flex items-center gap-3
          dark:bg-dark dark:border-dark
          bg-gray-50 border border-gray-200
          rounded-lg p-4
          transition-all duration-300
          hover:border-main
          hover:bg-main/5"
          data-zone="Centre Ville"
        >
          <div
            class="flex items-center justify-center
            shrink-0
            bg-main text-white
            rounded-full
            w-10 h-10"
          >
            <Icon name="lucide:map-pin" size={20} />
          </div>

          <span class="font-medium text-sm sm:text-base">
            Centre Ville
          </span>
        </div>

      </div>


      <!-- No result -->
      <div
        id="no-zone"
        class="hidden text-center mt-6"
      >
        <Icon
          name="lucide:map-pin-off"
          size={24}
          class="mx-auto mb-2 text-gray-400"
        />

        <p class="text-sm text-gray-500 dark:text-gray-400">
          Aucune zone trouvée.
        </p>
      </div>

    </div>

  </div>
</section>


<script>
  const searchInput = document.querySelector("#zone-search");
  const zones = document.querySelectorAll(".zone-item");
  const noZone = document.querySelector("#no-zone");

  searchInput?.addEventListener("input", () => {
    const search = searchInput.value
      .toLowerCase()
      .trim();

    let visibleZones = 0;

    zones.forEach((zone) => {
      const name =
        zone.getAttribute("data-zone")?.toLowerCase() || "";

      if (name.includes(search)) {
        zone.classList.remove("hidden");
        visibleZones++;
      } else {
        zone.classList.add("hidden");
      }
    });

    if (visibleZones === 0) {
      noZone?.classList.remove("hidden");
    } else {
      noZone?.classList.add("hidden");
    }
  });
</script>
