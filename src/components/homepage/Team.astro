---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import Swiper from "../Swiper.astro";

const reviews = (await getCollection("team"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);
---

<section class="section section-reviews">
  <div class="container">

    <!-- Header -->
    <div class="border-b border-b-main pb-10">
      <div>

        <div class="flex flex-wrap justify-between items-center gap-3">
          <h2>Avis de nos clients</h2>

          <p>
            <a
              href="/team"
              class="text-main underline hover:no-underline"
            >
              Tous les avis
            </a>
          </p>
        </div>

        <p class="mb-3">
          Découvrez les avis laissés par nos clients après leur expérience
          avec Kech Delivery à Marrakech.
        </p>

      </div>
    </div>


    <!-- Reviews Slider -->
    <div class="reviews-slider-wrapper mt-10">

      <Swiper
        pagination={false}
        navigation={false}
        id="reviewsSwiper"
      >

        {
          reviews.map((review) => (
            <div class="swiper-slide h-auto">

              <article
                class="review-card h-full p-7 rounded-xl bg-gray-50 dark:bg-dark border border-gray-200 dark:border-gray-700"
              >

                <!-- Customer -->
                <div class="flex items-start justify-between gap-4">

                  <!-- Customer Info -->
                  <div class="flex items-center gap-3 min-w-0">

                    <!-- Avatar -->
                    <div class="review-avatar shrink-0">
                      <Image
                        src={review.data.avatar}
                        alt={`Photo de ${review.data.title}`}
                        width={48}
                        height={48}
                        format="webp"
                        quality={80}
                        class="w-full h-full rounded-full object-cover"
                      />
                    </div>

                    <!-- Name -->
                    <div class="min-w-0">

                      <p class="review-name">
                        {review.data.title}
                      </p>

                      <p class="review-guide text-gray-500 dark:text-gray-400">
                        Local Guide
                      </p>

                    </div>

                  </div>


                  <!-- Google -->
                  <div class="review-google shrink-0">

                    <svg
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                      aria-label="Google"
                    >
                      <path
                        d="M21.35 12.27c0-.79-.07-1.55-.2-2.27H12v4.3h5.24a4.48 4.48 0 0 1-1.94 2.94v2.45h3.14c1.84-1.69 2.91-4.18 2.91-7.42Z"
                        fill="#4285F4"
                      />

                      <path
                        d="M12 21.5c2.63 0 4.84-.87 6.45-2.36l-3.14-2.45c-.87.58-1.98.92-3.31.92-2.54 0-4.69-1.72-5.46-4.03H3.29v2.53A9.74 9.74 0 0 0 12 21.5Z"
                        fill="#34A853"
                      />

                      <path
                        d="M6.54 13.58a5.86 5.86 0 0 1 0-3.76V7.29H3.29a9.5 9.5 0 0 0 0 8.82l3.25-2.53Z"
                        fill="#FBBC05"
                      />

                      <path
                        d="M12 5.79c1.43 0 2.71.49 3.72 1.46l2.79-2.79C16.84 2.87 14.63 2 12 2a9.74 9.74 0 0 0-8.71 5.29l3.25 2.53C7.31 7.51 9.46 5.79 12 5.79Z"
                        fill="#EA4335"
                      />
                    </svg>

                  </div>

                </div>


                <!-- Rating -->
                <div class="review-meta">

                  <div class="review-stars">
                    {
                      Array.from({
                        length: review.data.rating || 5,
                      }).map(() => (
                        <Icon
                          name="heroicons:star-solid"
                          size={18}
                        />
                      ))
                    }
                  </div>

                  <span class="review-time text-gray-500 dark:text-gray-400">
                    {review.data.time}
                  </span>

                </div>


                <!-- Review -->
                <p class="review-text text-gray-700 dark:text-gray-300">
                  {review.data.description}
                </p>

              </article>

            </div>
          ))
        }

      </Swiper>


      <!-- Navigation -->
      <div class="reviews-navigation">

        <button
          id="reviews-prev"
          type="button"
          class="reviews-arrow bg-white dark:bg-dark border-gray-200 dark:border-gray-700 text-dark dark:text-white"
          aria-label="Avis précédent"
        >
          <Icon name="heroicons:arrow-left" size={20} />
        </button>


        <div class="reviews-counter">

          <span>15+</span>

          <small class="text-gray-500 dark:text-gray-400">
            Avis clients
          </small>

        </div>


        <button
          id="reviews-next"
          type="button"
          class="reviews-arrow bg-white dark:bg-dark border-gray-200 dark:border-gray-700 text-dark dark:text-white"
          aria-label="Avis suivant"
        >
          <Icon name="heroicons:arrow-right" size={20} />
        </button>

      </div>

    </div>

  </div>
</section>


<style>
  /* ================================
     Reviews
  ================================= */

  .reviews-slider-wrapper {
    position: relative;
  }


  /* ================================
     Review Card
  ================================= */

  .review-card {
    transition:
      transform 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  .review-card:hover {
    border-color: rgba(244, 78, 30, 0.35);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.06);
  }


  /* ================================
     Avatar
  ================================= */

  .review-avatar {
    width: 48px;
    height: 48px;

    overflow: hidden;
    border-radius: 9999px;

    flex-shrink: 0;
  }


  /* ================================
     Customer
  ================================= */

  .review-name {
    margin: 0;

    font-size: 16px;
    font-weight: 700;
  }

  .review-guide {
    margin: 3px 0 0;

    font-size: 12px;
  }


  /* ================================
     Google
  ================================= */

  .review-google {
    display: flex;
    align-items: center;
    justify-content: center;
  }


  /* ================================
     Rating
  ================================= */

  .review-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;

    gap: 10px;

    margin-top: 22px;
  }

  .review-stars {
    display: flex;
    align-items: center;

    gap: 2px;

    color: #f4b400;
  }

  .review-time {
    font-size: 13px;
  }


  /* ================================
     Review Text
  ================================= */

  .review-text {
    margin-top: 18px;
    margin-bottom: 0;

    font-size: 15px;
    line-height: 1.75;
  }


  /* ================================
     Navigation
  ================================= */

  .reviews-navigation {
    display: flex;
    align-items: center;
    justify-content: center;

    gap: 18px;

    margin-top: 30px;
  }

  .reviews-arrow {
    width: 46px;
    height: 46px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-width: 1px;
    border-style: solid;
    border-radius: 9999px;

    cursor: pointer;

    transition:
      background 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  .reviews-arrow:hover {
    background: var(--color-main);
    border-color: var(--color-main);
    color: white;

    transform: translateY(-2px);
  }

  .reviews-arrow:active {
    transform: translateY(0);
  }


  /* ================================
     Counter
  ================================= */

  .reviews-counter {
    min-width: 90px;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    line-height: 1;
  }

  .reviews-counter span {
    font-size: 17px;
    font-weight: 700;

    color: var(--color-main);
  }

  .reviews-counter small {
    margin-top: 5px;

    font-size: 11px;
  }


  /* ================================
     Mobile
  ================================= */

  @media (max-width: 639px) {

    .review-card {
      padding: 22px;
      border-radius: 18px;
    }

    .review-text {
      font-size: 14px;
      line-height: 1.7;
    }

    .reviews-navigation {
      margin-top: 24px;
      gap: 14px;
    }

    .reviews-arrow {
      width: 42px;
      height: 42px;
    }

  }
</style>


<script>
  import Swiper from "swiper";
  import { Navigation } from "swiper/modules";

  new Swiper("#reviewsSwiper", {
    modules: [Navigation],

    loop: true,

    spaceBetween: 20,

    slidesPerView: 1,

    breakpoints: {
      640: {
        slidesPerView: 1.2,
      },

      768: {
        slidesPerView: 2,
      },

      1024: {
        slidesPerView: 3,
      },
    },

    navigation: {
      nextEl: "#reviews-next",
      prevEl: "#reviews-prev",
    },
  });
</script>
