<section class="section section-services">
  <div class="container">

    <!-- Section header -->
    <div class="border-b border-b-main pb-10">
      <div>
        <div class="flex flex-wrap justify-between items-center gap-3">
          <p class="font-semibold mb-3 text-xl">
            Nos zones de livraison
          </p>

          <p>
            <a
              href="/contact"
              class="text-main underline hover:no-underline"
            >
              Vérifier ma zone
            </a>
          </p>
        </div>

        <p class="mb-3">
          Nous assurons nos livraisons dans les principaux quartiers de
          Marrakech, rapidement et en toute simplicité.
        </p>
      </div>
    </div>

    <!-- Map -->
    <div
      class="relative mt-10 overflow-hidden rounded-3xl
      border border-gray-200 bg-[#fafafa]"
    >

      <!-- Decorative background -->
      <div
        class="absolute inset-0 opacity-40"
        style="
          background-image:
            linear-gradient(#e5e7eb 1px, transparent 1px),
            linear-gradient(90deg, #e5e7eb 1px, transparent 1px);
          background-size: 50px 50px;
        "
      ></div>

      <!-- Map area -->
      <div
        class="relative min-h-[520px] sm:min-h-[600px]
        lg:min-h-[650px]"
      >

        <!-- SVG -->
        <svg
          viewBox="0 0 1000 650"
          class="absolute inset-0 w-full h-full"
          preserveAspectRatio="xMidYMid meet"
          aria-label="Zones de livraison à Marrakech"
        >

          <!-- Main roads -->
          <g
            fill="none"
            stroke="#d1d5db"
            stroke-width="3"
            stroke-linecap="round"
            opacity=".8"
          >

            <!-- Horizontal -->
            <path d="M90 325 C280 300 390 320 500 325 C650 330 790 350 920 325" />

            <!-- Vertical -->
            <path d="M500 70 C480 190 490 260 500 325 C510 420 520 500 500 590" />

            <!-- Diagonal -->
            <path d="M170 140 C300 210 400 260 500 325 C600 390 700 440 850 520" />

            <path d="M850 130 C720 190 610 260 500 325 C390 390 290 450 130 520" />

          </g>

          <!-- Secondary roads -->
          <g
            fill="none"
            stroke="#e5e7eb"
            stroke-width="2"
            stroke-linecap="round"
          >

            <path d="M120 230 C300 250 380 270 500 325" />
            <path d="M870 230 C700 250 610 285 500 325" />

            <path d="M250 560 C350 470 420 400 500 325" />
            <path d="M750 560 C650 470 580 400 500 325" />

          </g>

          <!-- Coverage area -->
          <circle
            cx="500"
            cy="325"
            r="190"
            fill="#F44E1E"
            opacity=".035"
          />

          <circle
            cx="500"
            cy="325"
            r="135"
            fill="#F44E1E"
            opacity=".04"
          />

          <!-- Connection lines -->
          <g
            stroke="#F44E1E"
            stroke-width="2"
            stroke-dasharray="5 7"
            opacity=".45"
          >
            <line x1="500" y1="325" x2="215" y2="150" />
            <line x1="500" y1="325" x2="790" y2="150" />
            <line x1="500" y1="325" x2="850" y2="325" />
            <line x1="500" y1="325" x2="190" y2="500" />
            <line x1="500" y1="325" x2="690" y2="510" />
            <line x1="500" y1="325" x2="500" y2="575" />
          </g>

        </svg>

        <!-- ========================= -->
        <!-- GUÉLIZ -->
        <!-- ========================= -->

        <div
          class="absolute left-1/2 top-1/2
          -translate-x-1/2 -translate-y-1/2
          text-center"
        >

          <div
            class="relative mx-auto w-24 h-24 sm:w-28 sm:h-28
            rounded-full bg-main
            flex items-center justify-center
            shadow-[0_8px_30px_rgba(244,78,30,.25)]"
          >

            <div
              class="absolute inset-2 rounded-full
              border border-white/30"
            ></div>

            <div class="text-white">
              <p class="text-[10px] uppercase tracking-widest opacity-80">
                Centre
              </p>

              <p class="font-bold text-lg sm:text-xl">
                Guéliz
              </p>
            </div>

          </div>

        </div>

        <!-- ========================= -->
        <!-- PALMERAIE -->
        <!-- ========================= -->

        <div
          class="absolute left-[18%] top-[15%]
          flex flex-col items-center"
        >

          <span
            class="w-4 h-4 rounded-full bg-main
            border-4 border-white shadow"
          ></span>

          <div
            class="mt-2 bg-white rounded-xl px-4 py-2
            shadow-sm border border-gray-100 text-center"
          >
            <p class="font-semibold text-sm">
              Palmeraie
            </p>

            <p class="text-xs text-gray-400">
              Zone desservie
            </p>
          </div>

        </div>

        <!-- ========================= -->
        <!-- MASSIRA -->
        <!-- ========================= -->

        <div
          class="absolute left-[8%] top-[38%]
          flex items-center gap-3"
        >

          <div
            class="bg-white rounded-xl px-4 py-2
            shadow-sm border border-gray-100 text-right"
          >
            <p class="font-semibold text-sm">
              Massira
            </p>

            <p class="text-xs text-gray-400">
              Zone desservie
            </p>
          </div>

          <span
            class="w-4 h-4 rounded-full bg-main
            border-4 border-white shadow"
          ></span>

        </div>

        <!-- ========================= -->
        <!-- HIVERNAGE -->
        <!-- ========================= -->

        <div
          class="absolute right-[7%] top-[39%]
          flex items-center gap-3"
        >

          <span
            class="w-4 h-4 rounded-full bg-main
            border-4 border-white shadow"
          ></span>

          <div
            class="bg-white rounded-xl px-4 py-2
            shadow-sm border border-gray-100"
          >
            <p class="font-semibold text-sm">
              Hivernage
            </p>

            <p class="text-xs text-gray-400">
              Zone desservie
            </p>
          </div>

        </div>

        <!-- ========================= -->
        <!-- M'HAMID -->
        <!-- ========================= -->

        <div
          class="absolute left-[13%] bottom-[13%]
          flex flex-col items-center"
        >

          <div
            class="bg-white rounded-xl px-4 py-2
            shadow-sm border border-gray-100 text-center"
          >
            <p class="font-semibold text-sm">
              M'Hamid
            </p>

            <p class="text-xs text-gray-400">
              Zone desservie
            </p>
          </div>

          <span
            class="mt-2 w-4 h-4 rounded-full bg-main
            border-4 border-white shadow"
          ></span>

        </div>

        <!-- ========================= -->
        <!-- AGDAL -->
        <!-- ========================= -->

        <div
          class="absolute right-[18%] bottom-[13%]
          flex flex-col items-center"
        >

          <div
            class="bg-white rounded-xl px-4 py-2
            shadow-sm border border-gray-100 text-center"
          >
            <p class="font-semibold text-sm">
              Agdal
            </p>

            <p class="text-xs text-gray-400">
              Zone desservie
            </p>
          </div>

          <span
            class="mt-2 w-4 h-4 rounded-full bg-main
            border-4 border-white shadow"
          ></span>

        </div>

        <!-- ========================= -->
        <!-- ROUTE DE L'OURIKA -->
        <!-- ========================= -->

        <div
          class="absolute left-1/2 bottom-[4%]
          -translate-x-1/2 text-center"
        >

          <span
            class="mx-auto w-4 h-4 rounded-full bg-main
            border-4 border-white shadow block"
          ></span>

          <div
            class="mt-2 bg-white rounded-xl px-4 py-2
            shadow-sm border border-gray-100"
          >
            <p class="font-semibold text-sm whitespace-nowrap">
              Route de l'Ourika
            </p>

            <p class="text-xs text-gray-400">
              Zone desservie
            </p>
          </div>

        </div>

        <!-- Map label -->

        <div
          class="absolute top-5 left-5
          bg-white/90 backdrop-blur-sm
          rounded-xl px-4 py-3
          border border-gray-100 shadow-sm"
        >
          <p class="font-semibold text-sm">
            📍 Marrakech
          </p>

          <p class="text-xs text-gray-400 mt-1">
            Nos principales zones
          </p>
        </div>

      </div>
    </div>

  </div>
</section>
