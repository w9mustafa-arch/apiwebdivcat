---
import { Image } from "astro:assets";
---

<section
  class="section-hero bg-gray-50 py-10 lg:py-20 bg-no-repeat bg-cover relative overflow-hidden z-0"
>
  <Image
    src="/img/bg/banner01.webp"
    alt=""
    width={1200}
    height={600}
    loading="eager"
    fetchpriority="high"
    format="webp"
    quality={45}
    class="absolute inset-0 w-full h-full object-cover object-top -z-10"
  />
  <div class="absolute inset-0 bg-white/80 dark:bg-black/80 md:bg-transparent -z-10"></div>
  <div class="container z-10">
    <div class="sm:max-w-md md:max-w-xl text-center sm:text-left">
      <p class="text-sm mb-1">Disponible 24h/24 & 7j/7</p>
      <h1>Livreur Marrakech rapide pour tous vos besoins</h1>
      <p>
      Repas, courses, médicaments, colis ou achats urgents — Nous livrons tout ce dont vous avez besoin, partout à Marrakech, en un temps record.
      </p>
      <div class="mt-6 grid grid-cols-2 gap-4 max-w-sm mx-auto sm:mx-0">
        <a
          href="#"
          class="btn bg-main border-main text-white rounded-lg hover:bg-green-600"
          >Appeler maintenant</a
        >
        <a
          href="#"
          class="btn btn-outline hover:bg-white hover:border-white rounded-lg"
          >WhatsApp</a
        >
      </div>
    </div>
  </div>
</section>
