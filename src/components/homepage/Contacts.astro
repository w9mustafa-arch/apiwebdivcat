---
import { Icon } from "astro-icon/components";
---

<section class="section section-contacts">
  <div class="container">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
      <div>
        <h3 class="font-semibold text-xl lg:text-[40px]">Contactez-nous</h3>
        <div class="mt-10 grid gap-6">
          <div
            class="grid grid-cols-[54px_1fr] gap-4 items-center dark:bg-dark dark:border-dark bg-gray-50 border border-gray-200 rounded-lg p-4"
          >
            <div
              class="bg-main text-white flex items-center justify-center rounded-full w-13.5 h-13.5"
            >
              <Icon name="lucide:phone-call" size={24} />
            </div>
            <div>
              <p class="font-semibold text-lg mb-0">Appelez-nous</p>
              <a href="tel:+(08)255201888">+(08) 255 201 888</a>
            </div>
          </div>

          <div
            class="grid grid-cols-[54px_1fr] gap-4 items-center dark:bg-dark dark:border-dark bg-gray-50 border border-gray-200 rounded-lg p-4"
          >
            <div
              class="bg-main text-white flex items-center justify-center rounded-full w-13.5 h-13.5"
            >
              <Icon name="lucide:mail" size={24} />
            </div>
            <div>
              <p class="font-semibold text-lg mb-0">Écrivez-nous</p>
              <a href="mailto:Hello@procleaning.com">Hello@procleaning.com</a>
            </div>
          </div>

          <div
            class="grid grid-cols-[54px_1fr] gap-4 items-center dark:bg-dark dark:border-dark bg-gray-50 border border-gray-200 rounded-lg p-4"
          >
            <div
              class="bg-main text-white flex items-center justify-center rounded-full w-13.5 h-13.5"
            >
              <Icon name="lucide:map-pin" size={24} />
            </div>
            <div>
              <p class="font-semibold text-lg mb-0">Notre adresse</p>
              <a href="#"
                ><address class="not-italic">
                  Marrakech, Maroc
                </address></a
              >
            </div>
          </div>
        </div>
      </div>
      <div>
        <p class="text-sm mb-0">Besoin d’aide ?</p>
        <h3 class="font-semibold text-xl lg:text-[40px] mb-3">Parlons de votre livraison</h3>
        <p class="">
          Une question, une demande ou un besoin particulier ? Contactez-nous et notre équipe vous répondra rapidement pour vous accompagner.
        </p>

        <form action="/" method="POST" class="mt-8 grid gap-3">
          <fieldset class="fieldset">
            <input
              type="text"
              placeholder="Votre nom"
              class="input w-full validator"
              id="contact-name"
              name="contact_name"
              required
            />
            <p class="validator-hint hidden">Ce champ est obligatoire</p>
          </fieldset>

          <fieldset class="fieldset">
            <input
              type="text"
              placeholder="Votre e-mail"
              class="input w-full validator"
              id="contact-email"
              name="contact_email"
              required
            />
            <p class="validator-hint hidden">Ce champ est obligatoire</p>
          </fieldset>
          <fieldset class="fieldset">
            <textarea
              class="textarea w-full validator"
              placeholder="Votre message"
              id="contact-msg"
              name="contact_msg"
              required></textarea>
            <p class="validator-hint hidden">Ce champ est obligatoire</p>
          </fieldset>
          <button
            class="btn bg-main border-main text-white rounded-lg hover:bg-green-600 shadow-none lg:mr-auto"
            type="submit">Envoyer ma demande</button
          >
        </form>
      </div>
    </div>
  </div>
</section>
