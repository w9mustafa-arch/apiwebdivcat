---
import { Icon } from "astro-icon/components";
import Layout from "../layouts/Main.astro";

const marrakechZones = [
  { name: "Guéliz", search: "gueliz guéliz" },
  { name: "Hivernage", search: "hivernage" },
  { name: "Médina", search: "medina médina" },
  { name: "Kasbah", search: "kasbah" },
  { name: "Mellah", search: "mellah" },
  { name: "Sidi Youssef Ben Ali", search: "sidi youssef ben ali syba" },
  { name: "Daoudiate", search: "daoudiate" },
  { name: "Bab Doukkala", search: "bab doukkala" },
  { name: "Semlalia", search: "semlalia" },
  { name: "Targa", search: "targa" },
  { name: "Massira", search: "massira al massira" },
  { name: "M'Hamid", search: "mhamid m hamid" },
  { name: "Azli", search: "azli" },
  { name: "Issil", search: "issil" },
  { name: "Amerchich", search: "amerchich" },
  { name: "Hay Al Qods", search: "hay al qods qods" },
  { name: "Sidi Ghanem", search: "sidi ghanem" },
  { name: "Palmeraie", search: "palmeraie" },
  { name: "Agdal", search: "agdal" },
  { name: "Chrifia", search: "chrifia" },
  { name: "Tassoultante", search: "tassoultante" },
  { name: "Centre Ville", search: "centre ville" },
];

const routeZones = [
  { name: "Route de l'Ourika", search: "route ourika ourika" },
  { name: "Route de Targa", search: "route targa" },
  { name: "Route de Fès", search: "route fes fès" },
  { name: "Route de Casablanca", search: "route casablanca" },
  { name: "Route de Safi", search: "route safi" },
  { name: "Route de Ouarzazate", search: "route ouarzazate" },
  { name: "Route de l'Aéroport", search: "route aeroport aéroport" },
  { name: "Route de Tahannaout", search: "route tahannaout" },
];

const surroundingZones = [
  { name: "Tamansourt", search: "tamansourt" },
  { name: "Saada", search: "saada" },
  { name: "Harbil", search: "harbil" },
  { name: "Aït Ourir", search: "ait ourir aït ourir" },
  { name: "Tameslohte", search: "tameslohte" },
  { name: "Tahannaout", search: "tahannaout" },
  { name: "Sidi Abdallah Ghiat", search: "sidi abdallah ghiat" },
  { name: "Chwiter", search: "chwiter" },
  { name: "Aghmat", search: "aghmat" },
  { name: "Lalla Takerkoust", search: "lalla takerkoust takerkoust" },
  { name: "Amizmiz", search: "amizmiz" },
  { name: "Ourika", search: "ourika vallée ourika" },
  { name: "Setti Fatma", search: "setti fatma" },
  { name: "Moulay Brahim", search: "moulay brahim" },
  { name: "Asni", search: "asni" },
  { name: "Ouirgane", search: "ouirgane" },
  { name: "Imlil", search: "imlil" },
];

const totalZones =
  marrakechZones.length +
  routeZones.length +
  surroundingZones.length;
---

<Layout
  title="Zones de livraison"
  description="Zones de livraison de Kech Delivery à Marrakech et ses environs."
>
  <section class="section">
    <div class="container">

      <!-- Breadcrumbs -->
      <div class="breadcrumbs text-sm mb-8 sm:mb-10">
        <ul class="flex! flex-wrap">
          <li>
            <a href="/">Accueil</a>
          </li>

          <li>Zones de livraison</li>
        </ul>
      </div>


      <!-- Search -->
      <div class="mx-auto w-full max-w-2xl">

        <div
          class="flex w-full items-center overflow-hidden rounded-lg border border-gray-200 bg-gray-50 transition-all duration-200 focus-within:border-main focus-within:ring-2 focus-within:ring-main/10 dark:border-gray-700 dark:bg-dark"
        >

          <div
            class="flex h-full shrink-0 items-center justify-center pl-4 text-main"
          >
            <Icon
              name="lucide:search"
              size={19}
            />
          </div>

          <input
            id="zone-search"
            type="search"
            autocomplete="off"
            spellcheck="false"
            placeholder="Rechercher votre quartier ou votre ville..."
            aria-label="Rechercher une zone de livraison"
            class="min-w-0 w-full border-0 bg-transparent px-3 py-3.5 text-sm text-dark outline-none ring-0 placeholder:text-gray-400 focus:border-0 focus:outline-none focus:ring-0 dark:text-white dark:placeholder:text-gray-500"
          />

          <button
            id="clear-search"
            type="button"
            aria-label="Effacer la recherche"
            class="mr-2 hidden h-8 w-8 shrink-0 items-center justify-center rounded-full bg-gray-200 text-gray-500 transition-colors hover:bg-main hover:text-white dark:bg-gray-700 dark:text-gray-300"
          >
            <Icon
              name="lucide:x"
              size={16}
            />
          </button>

        </div>

      </div>


      <!-- Results -->
      <div
        id="results-info"
        class="mt-5 flex items-center justify-center gap-1.5 text-xs text-gray-500 dark:text-gray-400"
      >
        <span
          id="results-count"
          class="font-bold text-main"
        >
          {totalZones}
        </span>

        <span>zones disponibles</span>
      </div>


      <!-- Zones -->
      <div id="zones-content">


        <!-- Marrakech -->
        <section class="zone-group mt-9">

          <div class="mb-4 flex items-center gap-3">

            <div
              class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-main text-white"
            >
              <Icon
                name="lucide:map-pin"
                size={19}
              />
            </div>

            <div>
              <h2 class="m-0 text-lg font-bold text-dark dark:text-white">
                Marrakech
              </h2>

              <p class="m-0 mt-1 text-xs text-gray-500 dark:text-gray-400">
                Quartiers et secteurs desservis à Marrakech
              </p>
            </div>

          </div>


          <div class="zones-grid">

            {
              marrakechZones.map((zone) => (
                <div
                  class="zone-item flex min-h-[58px] items-center gap-2 rounded-lg border border-gray-200 bg-gray-50 px-2.5 py-2 text-dark transition-colors duration-200 hover:border-main hover:bg-main/5 dark:border-gray-700 dark:bg-dark dark:text-white dark:hover:bg-main/10"
                  data-zone={`${zone.name} ${zone.search}`}
                >

                  <div
                    class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-main text-white"
                  >
                    <Icon
                      name="lucide:map-pin"
                      size={15}
                    />
                  </div>

                  <span class="min-w-0 text-xs font-semibold leading-tight">
                    {zone.name}
                  </span>

                </div>
              ))
            }

          </div>

        </section>


        <!-- Routes -->
        <section class="zone-group mt-11">

          <div class="mb-4 flex items-center gap-3">

            <div
              class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-main text-white"
            >
              <Icon
                name="lucide:route"
                size={19}
              />
            </div>

            <div>
              <h2 class="m-0 text-lg font-bold text-dark dark:text-white">
                Routes principales
              </h2>

              <p class="m-0 mt-1 text-xs text-gray-500 dark:text-gray-400">
                Principaux axes et routes desservis
              </p>
            </div>

          </div>


          <div class="zones-grid">

            {
              routeZones.map((zone) => (
                <div
                  class="zone-item flex min-h-[58px] items-center gap-2 rounded-lg border border-gray-200 bg-gray-50 px-2.5 py-2 text-dark transition-colors duration-200 hover:border-main hover:bg-main/5 dark:border-gray-700 dark:bg-dark dark:text-white dark:hover:bg-main/10"
                  data-zone={`${zone.name} ${zone.search}`}
                >

                  <div
                    class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-main text-white"
                  >
                    <Icon
                      name="lucide:map-pin"
                      size={15}
                    />
                  </div>

                  <span class="min-w-0 text-xs font-semibold leading-tight">
                    {zone.name}
                  </span>

                </div>
              ))
            }

          </div>

        </section>


        <!-- Around Marrakech -->
        <section class="zone-group mt-11">

          <div class="mb-4 flex items-center gap-3">

            <div
              class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-main text-white"
            >
              <Icon
                name="lucide:map"
                size={19}
              />
            </div>

            <div>
              <h2 class="m-0 text-lg font-bold text-dark dark:text-white">
                Autour de Marrakech
              </h2>

              <p class="m-0 mt-1 text-xs text-gray-500 dark:text-gray-400">
                Villes et communes aux alentours de Marrakech
              </p>
            </div>

          </div>


          <div class="zones-grid">

            {
              surroundingZones.map((zone) => (
                <div
                  class="zone-item flex min-h-[58px] items-center gap-2 rounded-lg border border-gray-200 bg-gray-50 px-2.5 py-2 text-dark transition-colors duration-200 hover:border-main hover:bg-main/5 dark:border-gray-700 dark:bg-dark dark:text-white dark:hover:bg-main/10"
                  data-zone={`${zone.name} ${zone.search}`}
                >

                  <div
                    class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-main text-white"
                  >
                    <Icon
                      name="lucide:map-pin"
                      size={15}
                    />
                  </div>

                  <span class="min-w-0 text-xs font-semibold leading-tight">
                    {zone.name}
                  </span>

                </div>
              ))
            }

          </div>

        </section>

      </div>


      <!-- No Results -->
      <div
        id="no-zone"
        class="hidden py-14 text-center"
      >

        <div
          class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-gray-100 text-gray-400 dark:bg-dark dark:text-gray-500"
        >
          <Icon
            name="lucide:map-pin-off"
            size={24}
          />
        </div>

        <h3 class="m-0 text-base font-bold text-dark dark:text-white">
          Aucune zone trouvée
        </h3>

        <p class="mx-auto mb-5 mt-2 max-w-md text-xs leading-relaxed text-gray-500 dark:text-gray-400">
          Nous ne trouvons pas cette zone dans notre liste de livraison.
        </p>

        <a
          href="/contact"
          class="inline-flex min-h-10 items-center justify-center gap-2 rounded-full bg-main px-5 text-sm font-semibold text-white transition-opacity hover:opacity-90"
        >
          <Icon
            name="lucide:message-circle"
            size={17}
          />

          <span>Contactez-nous</span>
        </a>

      </div>


      <!-- CTA -->
      <div
        class="mt-12 flex items-center gap-4 rounded-xl border border-main/20 bg-main/5 p-5 dark:border-main/30 dark:bg-main/10 max-sm:flex-col max-sm:text-center"
      >

        <div
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-main text-white"
        >
          <Icon
            name="lucide:map-pin-check"
            size={22}
          />
        </div>

        <div class="min-w-0 flex-1">

          <h3 class="m-0 text-base font-bold text-dark dark:text-white">
            Votre zone n'est pas dans la liste ?
          </h3>

          <p class="m-0 mt-1 text-xs leading-relaxed text-gray-500 dark:text-gray-400">
            Contactez-nous et nous vérifierons la possibilité de vous livrer.
          </p>

        </div>

        <a
          href="/contact"
          class="inline-flex min-h-10 shrink-0 items-center justify-center gap-2 rounded-full bg-main px-4 text-xs font-semibold text-white transition-opacity hover:opacity-90 max-sm:w-full"
        >
          <span>Vérifier ma zone</span>

          <Icon
            name="lucide:arrow-right"
            size={17}
          />
        </a>

      </div>

    </div>
  </section>
</Layout>


<style>
  .zones-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }

  .zone-item.hidden {
    display: none !important;
  }

  .zone-group.hidden {
    display: none !important;
  }

  /*
   * Supprime le bouton X natif الذي تضيفه بعض المتصفحات
   * داخل input[type="search"] حتى لا يظهر زرين.
   */
  #zone-search::-webkit-search-cancel-button,
  #zone-search::-webkit-search-decoration {
    -webkit-appearance: none;
    appearance: none;
  }

  #zone-search::-ms-clear {
    display: none;
  }

  @media (min-width: 640px) {
    .zones-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 10px;
    }
  }

  @media (min-width: 1024px) {
    .zones-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 12px;
    }

    .zone-item {
      min-height: 62px;
    }
  }

  @media (max-width: 639px) {
    .zones-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .zone-item span {
      overflow-wrap: anywhere;
    }
  }
</style>


<script>
  const searchInput = document.querySelector("#zone-search");
  const zoneItems = Array.from(
    document.querySelectorAll(".zone-item")
  );
  const zoneGroups = Array.from(
    document.querySelectorAll(".zone-group")
  );
  const noZone = document.querySelector("#no-zone");
  const resultsInfo = document.querySelector("#results-info");
  const resultsCount = document.querySelector("#results-count");
  const clearSearch = document.querySelector("#clear-search");

  const normalizeText = (value) => {
    return String(value || "")
      .toLowerCase()
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .replace(/\s+/g, " ")
      .trim();
  };

  const updateSearch = () => {
    if (!searchInput) return;

    const search = normalizeText(searchInput.value);
    let visibleCount = 0;

    zoneItems.forEach((item) => {
      const zoneText = normalizeText(
        item.getAttribute("data-zone") || item.textContent
      );

      const words = search.split(" ").filter(Boolean);

      const matches =
        search === "" ||
        words.every((word) => zoneText.includes(word));

      item.classList.toggle("hidden", !matches);

      if (matches) {
        visibleCount++;
      }
    });

    zoneGroups.forEach((group) => {
      const visibleItems = group.querySelectorAll(
        ".zone-item:not(.hidden)"
      );

      group.classList.toggle(
        "hidden",
        visibleItems.length === 0
      );
    });

    if (resultsCount) {
      resultsCount.textContent = String(visibleCount);
    }

    if (clearSearch) {
      clearSearch.classList.toggle(
        "hidden",
        search === ""
      );

      clearSearch.classList.toggle(
        "flex",
        search !== ""
      );
    }

    if (noZone) {
      noZone.classList.toggle(
        "hidden",
        visibleCount !== 0 || search === ""
      );
    }

    if (resultsInfo) {
      resultsInfo.classList.toggle(
        "hidden",
        visibleCount === 0 && search !== ""
      );
    }
  };

  searchInput?.addEventListener("input", updateSearch);

  clearSearch?.addEventListener("click", () => {
    if (!searchInput) return;

    searchInput.value = "";
    updateSearch();
    searchInput.focus();
  });
</script>
