---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Main.astro";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

const reviews = (await getCollection("team")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout title="Avis de nos clients">
  <section class="section section-reviews-page">
    <div class="container">

      <!-- Reviews Header -->
      <div class="reviews-header border-b border-b-main pb-10">
        <h1>Avis de nos clients</h1>

        <p class="mt-4 max-w-2xl">
          Découvrez les avis laissés par nos clients après leur expérience
          avec Kech Delivery à Marrakech.
        </p>
      </div>


      <!-- Reviews Grid -->
      <div
        id="reviews-grid"
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 mt-10"
      >
        {
          reviews.map((review, index) => (
            <article
              class:list={[
                "review-card h-full p-7 rounded-xl bg-gray-50 dark:bg-dark border border-gray-200 dark:border-gray-700",
                { "review-hidden": index >= 6 },
              ]}
              data-review
            >

              <!-- Customer -->
              <div class="flex items-start justify-between gap-4">

                <!-- Customer Info -->
                <div class="flex items-center gap-3 min-w-0">

                  <!-- Avatar -->
                  <div class="review-avatar shrink-0">
                    {review.data.thumbnail ? (
                      <Image
                        src={review.data.thumbnail}
                        alt={`Photo de ${review.data.title}`}
                        format="webp"
                        quality={100}
                        class="w-full h-full rounded-full object-cover"
                      />
                    ) : (
                      <span>
                        {review.data.title.charAt(0)}
                      </span>
                    )}
                  </div>


                  <!-- Name + Date -->
                  <div class="min-w-0">

                    <p class="review-name">
                      {review.data.title}
                    </p>

                    <p class="review-guide text-gray-500 dark:text-gray-400">
                      {review.data.time}
                    </p>

                  </div>

                </div>


                <!-- Google -->
                <div class="review-google shrink-0">

                  <svg
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    aria-label="Google"
                  >

                    <path
                      d="M21.35 12.27c0-.79-.07-1.55-.2-2.27H12v4.3h5.24a4.48 4.48 0 0 1-1.94 2.94v2.45h3.14c1.84-1.69 2.91-4.18 2.91-7.42Z"
                      fill="#4285F4"
                    />

                    <path
                      d="M12 21.5c2.63 0 4.84-.87 6.45-2.36l-3.14-2.45c-.87.58-1.98.92-3.31.92-2.54 0-4.69-1.72-5.46-4.03H3.29v2.53A9.74 9.74 0 0 0 12 21.5Z"
                      fill="#34A853"
                    />

                    <path
                      d="M6.54 13.58a5.86 5.86 0 0 1 0-3.76V7.29H3.29a9.5 9.5 0 0 0 0 8.82l3.25-2.53Z"
                      fill="#FBBC05"
                    />

                    <path
                      d="M12 5.79c1.43 0 2.71.49 3.72 1.46l2.79-2.79C16.84 2.87 14.63 2 12 2a9.74 9.74 0 0 0-8.71 5.29l3.25 2.53C7.31 7.51 9.46 5.79 12 5.79Z"
                      fill="#EA4335"
                    />

                  </svg>

                </div>

              </div>


              <!-- Rating -->
              <div class="review-meta">

                <div class="review-stars">
                  {
                    Array.from({ length: 5 }).map((_, index) => (
                      <Icon
                        name="heroicons:star-solid"
                        size={18}
                        class={
                          index < (review.data.rating || 5)
                            ? "review-star-active"
                            : "review-star-inactive"
                        }
                      />
                    ))
                  }
                </div>

              </div>


              <!-- Review -->
              <p class="review-text text-gray-700 dark:text-gray-300">
                {review.data.description}
              </p>

            </article>
          ))
        }
      </div>


      <!-- Load More -->
      {
        reviews.length > 6 && (
          <div class="reviews-load-more">

            <button
              id="load-more-reviews"
              type="button"
              class="load-more-button"
            >
              Afficher plus d'avis
            </button>

          </div>
        )
      }

    </div>
  </section>
</Layout>


<style>
  /* ================================
     Header
  ================================= */

  .reviews-header h1 {
    margin: 0;
  }

  .reviews-header p {
    margin-bottom: 0;
  }


  /* ================================
     Review Card
  ================================= */

  .review-card {
    transition:
      transform 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  .review-card:hover {
    border-color: rgba(244, 78, 30, 0.35);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.06);
  }


  /* ================================
     Hidden Reviews
  ================================= */

  .review-hidden {
    display: none;
  }


  /* ================================
     Avatar
  ================================= */

  .review-avatar {
    width: 48px;
    height: 48px;

    overflow: hidden;
    border-radius: 9999px;

    flex-shrink: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    background: rgba(244, 78, 30, 0.1);
    color: var(--color-main);

    font-size: 18px;
    font-weight: 700;
  }


  /* ================================
     Customer
  ================================= */

  .review-name {
    margin: 0;

    font-size: 16px;
    font-weight: 700;
  }

  .review-guide {
    margin: 3px 0 0;

    font-size: 12px;
  }


  /* ================================
     Google
  ================================= */

  .review-google {
    display: flex;
    align-items: center;
    justify-content: center;
  }


  /* ================================
     Rating
  ================================= */

  .review-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;

    gap: 10px;

    margin-top: 22px;
  }

  .review-stars {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .review-star-active {
    color: #f4b400;
  }

  .review-star-inactive {
    color: #d1d5db;
  }

  :global(.dark) .review-star-inactive {
    color: #4b5563;
  }


  /* ================================
     Review Text
  ================================= */

  .review-text {
    margin-top: 18px;
    margin-bottom: 0;

    font-size: 15px;
    line-height: 1.75;
  }


  /* ================================
     Load More
  ================================= */

  .reviews-load-more {
    display: flex;
    justify-content: center;

    margin-top: 40px;
  }

  .load-more-button {
    padding: 12px 26px;

    border: none;
    border-radius: 9999px;

    background: var(--color-main);
    color: white;

    font-size: 14px;
    font-weight: 600;

    cursor: pointer;

    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  .load-more-button:hover {
    opacity: 0.9;
    transform: translateY(-2px);
  }

  .load-more-button:active {
    transform: translateY(0);
  }


  /* ================================
     Mobile
  ================================= */

  @media (max-width: 639px) {

    .review-card {
      padding: 22px;
      border-radius: 18px;
    }

    .review-text {
      font-size: 14px;
      line-height: 1.7;
    }

    .reviews-load-more {
      margin-top: 30px;
    }

    .load-more-button {
      width: 100%;
      max-width: 280px;
    }

  }
</style>


<script>
  const loadMoreButton = document.getElementById(
    "load-more-reviews"
  );

  if (loadMoreButton) {

    const reviews = Array.from(
      document.querySelectorAll("[data-review]")
    );

    let visibleReviews = 6;

    loadMoreButton.addEventListener("click", () => {

      const nextReviews = reviews.slice(
        visibleReviews,
        visibleReviews + 6
      );

      nextReviews.forEach((review) => {
        review.classList.remove("review-hidden");
      });

      visibleReviews += 6;

      if (visibleReviews >= reviews.length) {
        loadMoreButton.style.display = "none";
      }

    });

  }
</script>
