---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import Layout from "../../layouts/Main.astro";
import Pagination from "../../components/pagination.astro";

export async function getStaticPaths({ paginate }) {
  const team = (await getCollection("team")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  );

  return paginate(team, {
    pageSize: 6,
  });
}

const { page } = Astro.props;
---

<Layout title="Avis de nos clients">
  <section class="section">
    <div class="container">

      <!-- Breadcrumbs -->
      <div class="breadcrumbs text-sm mb-10">
        <ul class="flex! flex-wrap">
          <li>
            <a href="/">Accueil</a>
          </li>

          <li>Avis de nos clients</li>
        </ul>
      </div>


      <!-- Reviews -->
      <div class="reviews-grid">

        {
          page.data.map((review) => (
            <article
              class="review-card h-full p-7 rounded-xl bg-gray-50 dark:bg-dark border border-gray-200 dark:border-gray-700"
            >

              <!-- Customer -->
              <div class="flex items-start justify-between gap-4">

                <!-- Customer Info -->
                <div class="flex items-center gap-3 min-w-0">

                  <!-- Avatar -->
                  <div class="review-avatar shrink-0">

                    {review.data.thumbnail ? (
                      <Image
                        src={review.data.thumbnail}
                        alt={`Photo de ${review.data.title}`}
                        format="webp"
                        quality={100}
                        class="w-full h-full rounded-full object-cover"
                      />
                    ) : (
                      <span>
                        {review.data.title.charAt(0)}
                      </span>
                    )}

                  </div>


                  <!-- Name + Date -->
                  <div class="min-w-0">

                    <p class="review-name">
                      {review.data.title}
                    </p>

                    <p class="review-guide text-gray-500 dark:text-gray-400">
                      {(() => {
                        const now = new Date();
                        const date = new Date(review.data.pubDate);

                        const diff =
                          now.getTime() - date.getTime();

                        const days = Math.floor(
                          diff / (1000 * 60 * 60 * 24)
                        );

                        if (days < 1) {
                          return "Aujourd'hui";
                        }

                        if (days === 1) {
                          return "Il y a 1 jour";
                        }

                        if (days < 7) {
                          return `Il y a ${days} jours`;
                        }

                        const weeks = Math.floor(days / 7);

                        if (weeks === 1) {
                          return "Il y a 1 semaine";
                        }

                        if (weeks < 5) {
                          return `Il y a ${weeks} semaines`;
                        }

                        const months = Math.floor(days / 30);

                        if (months <= 1) {
                          return "Il y a 1 mois";
                        }

                        if (months < 12) {
                          return `Il y a ${months} mois`;
                        }

                        const years = Math.floor(days / 365);

                        if (years === 1) {
                          return "Il y a 1 an";
                        }

                        return `Il y a ${years} ans`;
                      })()}
                    </p>

                  </div>

                </div>


                <!-- Google -->
                <div class="review-google shrink-0">

                  <svg
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    aria-label="Google"
                  >

                    <path
                      d="M21.35 12.27c0-.79-.07-1.55-.2-2.27H12v4.3h5.24a4.48 4.48 0 0 1-1.94 2.94v2.45h3.14c1.84-1.69 2.91-4.18 2.91-7.42Z"
                      fill="#4285F4"
                    />

                    <path
                      d="M12 21.5c2.63 0 4.84-.87 6.45-2.36l-3.14-2.45c-.87.58-1.98.92-3.31.92-2.54 0-4.69-1.72-5.46-4.03H3.29v2.53A9.74 9.74 0 0 0 12 21.5Z"
                      fill="#34A853"
                    />

                    <path
                      d="M6.54 13.58a5.86 5.86 0 0 1 0-3.76V7.29H3.29a9.5 9.5 0 0 0 0 8.82l3.25-2.53Z"
                      fill="#FBBC05"
                    />

                    <path
                      d="M12 5.79c1.43 0 2.71.49 3.72 1.46l2.79-2.79C16.84 2.87 14.63 2 12 2a9.74 9.74 0 0 0-8.71 5.29l3.25 2.53C7.31 7.51 9.46 5.79 12 5.79Z"
                      fill="#EA4335"
                    />

                  </svg>

                </div>

              </div>


              <!-- Rating -->
              <div class="review-meta">

                <div class="review-stars">

                  {
                    Array.from({ length: 5 }).map((_, index) => (
                      <Icon
                        name="heroicons:star-solid"
                        size={18}
                        class={
                          index < (review.data.rating || 5)
                            ? "review-star-active"
                            : "review-star-inactive"
                        }
                      />
                    ))
                  }

                </div>

              </div>


              <!-- Review -->
              <p class="review-text text-gray-700 dark:text-gray-300">
                {review.data.description}
              </p>

            </article>
          ))
        }

      </div>


      <!-- Pagination -->
      {
        page.lastPage > 1 && (
          <div class="reviews-pagination">

            <!-- Previous -->
            {page.url.prev ? (
              <a
                href={page.url.prev}
                class="pagination-button"
              >
                <Icon
                  name="heroicons:arrow-left"
                  size={20}
                />

                <span>Précédent</span>
              </a>
            ) : (
              <span class="pagination-button pagination-disabled">
                <Icon
                  name="heroicons:arrow-left"
                  size={20}
                />

                <span>Précédent</span>
              </span>
            )}


            <!-- Page -->
            <div class="pagination-info">

              <strong>
                {page.currentPage}
              </strong>

              <span>
                /
              </span>

              <span>
                {page.lastPage}
              </span>

            </div>


            <!-- Next -->
            {page.url.next ? (
              <a
                href={page.url.next}
                class="pagination-button"
              >
                <span>Suivant</span>

                <Icon
                  name="heroicons:arrow-right"
                  size={20}
                />
              </a>
            ) : (
              <span class="pagination-button pagination-disabled">
                <span>Suivant</span>

                <Icon
                  name="heroicons:arrow-right"
                  size={20}
                />
              </span>
            )}

          </div>
        )
      }

    </div>
  </section>
</Layout>


<style>

  /* ================================
     Reviews Grid
  ================================= */

  .reviews-grid {
    display: grid;

    grid-template-columns: 1fr;

    gap: 2.5rem;
  }


  @media (min-width: 640px) {

    .reviews-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

  }


  @media (min-width: 1024px) {

    .reviews-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

  }


  /* ================================
     Review Card
  ================================= */

  .review-card {
    transition:
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }


  .review-card:hover {
    border-color: rgba(244, 78, 30, 0.35);

    box-shadow:
      0 12px 30px rgba(0, 0, 0, 0.06);
  }


  /* ================================
     Avatar
  ================================= */

  .review-avatar {

    width: 48px;
    height: 48px;

    overflow: hidden;

    border-radius: 9999px;

    display: flex;
    align-items: center;
    justify-content: center;

    background: rgba(244, 78, 30, 0.1);

    color: var(--color-main);

    font-size: 18px;
    font-weight: 700;

    flex-shrink: 0;
  }


  /* ================================
     Customer
  ================================= */

  .review-name {

    margin: 0;

    font-size: 16px;

    font-weight: 700;
  }


  .review-guide {

    margin: 3px 0 0;

    font-size: 12px;
  }


  /* ================================
     Google
  ================================= */

  .review-google {

    display: flex;

    align-items: center;

    justify-content: center;
  }


  /* ================================
     Rating
  ================================= */

  .review-meta {

    display: flex;

    align-items: center;

    flex-wrap: wrap;

    gap: 10px;

    margin-top: 22px;
  }


  .review-stars {

    display: flex;

    align-items: center;

    gap: 2px;
  }


  .review-star-active {

    color: #f4b400;
  }


  .review-star-inactive {

    color: #d1d5db;
  }


  :global(.dark) .review-star-inactive {

    color: #4b5563;
  }


  /* ================================
     Review Text
  ================================= */

  .review-text {

    margin-top: 18px;

    margin-bottom: 0;

    font-size: 15px;

    line-height: 1.75;
  }


  /* ================================
     Pagination
  ================================= */

  .reviews-pagination {

    display: flex;

    align-items: center;

    justify-content: center;

    gap: 18px;

    margin-top: 50px;
  }


  .pagination-button {

    min-width: 46px;
    height: 46px;

    padding: 0 18px;

    display: inline-flex;

    align-items: center;

    justify-content: center;

    gap: 8px;

    border: 1px solid #e5e7eb;

    border-radius: 9999px;

    background: white;

    color: #1c232b;

    font-size: 14px;

    font-weight: 600;

    text-decoration: none;

    transition:
      background 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease,
      transform 0.2s ease;
  }


  .pagination-button:hover {

    background: var(--color-main);

    border-color: var(--color-main);

    color: white;

    transform: translateY(-2px);
  }


  .pagination-disabled {

    opacity: 0.4;

    cursor: not-allowed;

    pointer-events: none;
  }


  .pagination-info {

    min-width: 70px;

    display: flex;

    align-items: center;

    justify-content: center;

    gap: 5px;

    font-size: 14px;
  }


  .pagination-info strong {

    color: var(--color-main);

    font-size: 17px;
  }


  /* ================================
     Dark Mode
  ================================= */

  :global(.dark) .pagination-button {

    background: var(--color-dark);

    border-color: #374151;

    color: white;
  }


  /* ================================
     Mobile
  ================================= */

  @media (max-width: 639px) {

    .reviews-grid {

      gap: 1.5rem;
    }


    .review-card {

      padding: 22px;
    }


    .review-text {

      font-size: 14px;

      line-height: 1.7;
    }


    .reviews-pagination {

      gap: 10px;

      margin-top: 35px;
    }


    .pagination-button {

      height: 42px;

      padding: 0 14px;

      font-size: 13px;
    }


    .pagination-info {

      min-width: 45px;
    }

  }

</style>
