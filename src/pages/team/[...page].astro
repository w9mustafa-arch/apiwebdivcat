---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import Layout from "../../layouts/Main.astro";

export async function getStaticPaths({ paginate }) {
  const team = (await getCollection("team")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  );

  return paginate(team, {
    pageSize: 6,
  });
}

const { page } = Astro.props;
---

<Layout title="Avis clients">
  <section class="section">
    <div class="container">

      <!-- Breadcrumbs -->
      <div class="breadcrumbs text-sm mb-10">
        <ul class="flex! flex-wrap">
          <li>
            <a href="/">Accueil</a>
          </li>

          <li>Avis clients</li>
        </ul>
      </div>


      <!-- Reviews Grid -->
      <div
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8 items-stretch"
      >

        {
          page.data.map((review) => (
            <article
              class="review-card h-full p-7 rounded-xl bg-gray-50 dark:bg-dark border border-gray-200 dark:border-gray-700"
            >

              <!-- Customer -->
              <div class="flex items-start justify-between gap-4">

                <!-- Customer Info -->
                <div class="flex items-center gap-3 min-w-0">

                  <!-- Avatar -->
                  <div class="review-avatar shrink-0">

                    {review.data.thumbnail && (
                      <Image
                        src={review.data.thumbnail}
                        alt={`Photo de ${review.data.title}`}
                        format="webp"
                        quality={100}
                        class="w-full h-full rounded-full object-cover"
                      />
                    )}

                  </div>


                  <!-- Name + Manual Date -->
                  <div class="min-w-0">

                    <p class="review-name">
                      {review.data.title}
                    </p>

                    <!--
                      IMPORTANT:
                      Le texte de la date est manuel.
                      Exemple : "Il y a 1 mois"
                    -->
                    <p class="review-guide text-gray-500 dark:text-gray-400">
                      {review.data.time}
                    </p>

                  </div>

                </div>


                <div class="review-google shrink-0">
  <Icon
    name="heroicons:check-badge-20-solid"
    size={24}
    class="text-[#0075F1]"
    aria-label="Avis vérifié"
  />
     </div>

              </div>


              <!-- Rating -->
              <div class="review-meta">

                <div class="review-stars">

                  {
                    Array.from({ length: 5 }).map((_, index) => (
                      <Icon
                        name="heroicons:star-solid"
                        size={18}
                        class={
                          index < Math.min(review.data.rating || 5, 5)
                            ? "review-star-active"
                            : "review-star-inactive"
                        }
                      />
                    ))
                  }

                </div>

              </div>


              <!-- Review -->
              <p class="review-text text-gray-700 dark:text-gray-300">
                {review.data.description}
              </p>

            </article>
          ))
        }

      </div>


      <!-- Pagination -->
      {
        (page.url.prev || page.url.next) && (
          <div class="reviews-pagination">

            {
              page.url.prev ? (
                <a
                  href={page.url.prev}
                  class="pagination-button"
                >
                  <Icon
                    name="heroicons:arrow-left"
                    size={20}
                  />

                  <span>Avis précédents</span>
                </a>
              ) : (
                <span class="pagination-button pagination-disabled">
                  <Icon
                    name="heroicons:arrow-left"
                    size={20}
                  />

                  <span>Avis précédents</span>
                </span>
              )
            }


            <div class="pagination-info">

              <span>
                Page {page.currentPage}
              </span>

              <small>
                sur {page.lastPage}
              </small>

            </div>


            {
              page.url.next ? (
                <a
                  href={page.url.next}
                  class="pagination-button"
                >
                  <span>Avis suivants</span>

                  <Icon
                    name="heroicons:arrow-right"
                    size={20}
                  />
                </a>
              ) : (
                <span class="pagination-button pagination-disabled">
                  <span>Avis suivants</span>

                  <Icon
                    name="heroicons:arrow-right"
                    size={20}
                  />
                </span>
              )
            }

          </div>
        )
      }

    </div>
  </section>
</Layout>


<style>
  /* ================================
     Review Card
  ================================= */

  .review-card {
    display: flex;
    flex-direction: column;

    transition:
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  .review-card:hover {
    border-color: rgba(244, 78, 30, 0.35);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.06);
  }


  /* ================================
     Avatar
  ================================= */

  .review-avatar {
    width: 48px;
    height: 48px;

    overflow: hidden;

    border-radius: 9999px;

    background: rgba(244, 78, 30, 0.1);

    display: flex;
    align-items: center;
    justify-content: center;

    flex-shrink: 0;
  }


  /* ================================
     Customer
  ================================= */

  .review-name {
    margin: 0;

    font-size: 16px;
    font-weight: 700;

    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .review-guide {
    margin: 3px 0 0;

    font-size: 12px;
  }


  /* ================================
     Google
  ================================= */

  .review-google {
    display: flex;
    align-items: center;
    justify-content: center;
  }


  /* ================================
     Rating
  ================================= */

  .review-meta {
    display: flex;
    align-items: center;

    margin-top: 22px;
  }

  .review-stars {
    display: flex;
    align-items: center;

    gap: 2px;
  }

  .review-star-active {
    color: #f4b400;
  }

  .review-star-inactive {
    color: #d1d5db;
  }

  :global(.dark) .review-star-inactive {
    color: #4b5563;
  }


  /* ================================
     Review Text
  ================================= */

  .review-text {
    margin-top: 18px;
    margin-bottom: 0;

    font-size: 15px;
    line-height: 1.75;
  }


  /* ================================
     Pagination
  ================================= */

  .reviews-pagination {
    display: flex;
    align-items: center;
    justify-content: center;

    gap: 18px;

    margin-top: 50px;
  }


  /* ================================
     Pagination Button
  ================================= */

  .pagination-button {
    min-height: 46px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    gap: 8px;

    padding: 0 18px;

    border: 1px solid #e5e7eb;

    border-radius: 9999px;

    background: white;

    color: #1c232b;

    font-size: 14px;
    font-weight: 600;

    text-decoration: none;

    cursor: pointer;

    transition:
      background 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease,
      transform 0.2s ease;
  }


  .pagination-button:hover {
    background: var(--color-main);

    border-color: var(--color-main);

    color: white;

    transform: translateY(-2px);
  }


  .pagination-button:active {
    transform: translateY(0);
  }


  /* ================================
     Disabled
  ================================= */

  .pagination-disabled {
    opacity: 0.4;

    cursor: not-allowed;

    pointer-events: none;
  }


  /* ================================
     Pagination Info
  ================================= */

  .pagination-info {
    min-width: 70px;

    display: flex;
    flex-direction: column;

    align-items: center;
    justify-content: center;

    line-height: 1.2;

    text-align: center;
  }

  .pagination-info span {
    font-size: 14px;

    font-weight: 700;
  }

  .pagination-info small {
    margin-top: 3px;

    font-size: 11px;

    color: #6b7280;
  }


  /* ================================
     Mobile
  ================================= */

  @media (max-width: 639px) {

    .review-card {
      padding: 22px;
      border-radius: 18px;
    }

    .review-text {
      font-size: 14px;
      line-height: 1.7;
    }

    .reviews-pagination {
      gap: 10px;

      margin-top: 35px;
    }

    .pagination-button {
      width: 46px;
      height: 46px;

      min-height: 46px;

      padding: 0;

      border-radius: 9999px;
    }

    .pagination-button span {
      display: none;
    }

    .pagination-info {
      min-width: 55px;
    }
  }
</style>
